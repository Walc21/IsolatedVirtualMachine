[Unit]
Description=IsolateVM restricted egress proxy for %i
After=network-online.target isolatevm-egress-firewall.service
Wants=network-online.target
Requires=isolatevm-egress-firewall.service

[Service]
Type=simple
RuntimeDirectory=isolatevm-egress
RuntimeDirectoryMode=0755
ExecStartPre=/usr/sbin/squid -k parse -f /etc/isolatevm/egress/%i.conf
ExecStart=/usr/sbin/squid --foreground -N -f /etc/isolatevm/egress/%i.conf
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
